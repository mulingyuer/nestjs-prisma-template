{
	"name": "nestjs-prisma-template",
	"version": "0.0.1",
	"description": "这是一个Nestjs与Prisma的后端模板仓库",
	"author": "mulingyuer",
	"private": true,
	"license": "UNLICENSED",
	"prisma": {
		"seed": "ts-node -r tsconfig-paths/register -P ./tsconfig.json ./prisma/seed/index.ts"
	},
	"scripts": {
		"build": "cross-env NODE_ENV=production nest build",
		"build:all": "dotenv -e .env.production -- run-s prisma:deploy prisma:generate build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"barrel": "run-s generate-barrelsby-json barrelsby",
		"start": "cross-env NODE_ENV=development nest start",
		"start:dev": "chcp 65001 & cross-env NODE_ENV=development nest start --watch",
		"start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
		"start:prod": "cross-env NODE_ENV=production node dist/src/main",
		"prisma:migrate": "dotenv -e .env.development prisma migrate dev",
		"prisma:reset": "dotenv -e .env.development prisma migrate reset",
		"prisma:deploy": "prisma migrate deploy",
		"prisma:generate": "prisma generate",
		"prisma:seed": "prisma db seed",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"type-check": "tsc --noEmit",
		"generate-barrelsby-json": "ts-node ./scripts/generate-barrelsby-json/index.ts",
		"barrelsby": "barrelsby --config barrelsby.json --delete",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json"
	},
	"dependencies": {
		"@nestjs/common": "^11.1.2",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.1.2",
		"@nestjs/jwt": "^11.0.0",
		"@nestjs/mapped-types": "^2.1.0",
		"@nestjs/platform-express": "^11.1.2",
		"@nestjs/schedule": "^6.0.0",
		"@nestjs/swagger": "^11.2.0",
		"@node-rs/argon2": "^2.0.2",
		"@prisma/client": "^6.6.0",
		"axios": "^1.9.0",
		"axios-retry": "^4.5.0",
		"barrelsby": "^2.8.1",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.2",
		"helmet": "^8.1.0",
		"ioredis": "^5.6.1",
		"multer": "^2.0.1",
		"nestjs-pino": "^4.4.0",
		"npm-run-all2": "^8.0.4",
		"pino-http": "^10.5.0",
		"pino-pretty": "^13.0.0",
		"pino-roll": "^3.1.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"uuid": "^11.1.0",
		"zxcvbn": "^4.4.2"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.18.0",
		"@nestjs/cli": "^11.0.7",
		"@nestjs/schematics": "^11.0.5",
		"@nestjs/testing": "^11.1.2",
		"@swc/cli": "^0.7.7",
		"@swc/core": "^1.11.31",
		"@types/express": "^5.0.2",
		"@types/jest": "^29.5.14",
		"@types/multer": "^1.4.12",
		"@types/node": "^22.15.29",
		"@types/supertest": "^6.0.3",
		"@types/uuid": "^10.0.0",
		"@types/zxcvbn": "^4.4.5",
		"cross-env": "^7.0.3",
		"dotenv": "^16.5.0",
		"dotenv-cli": "^8.0.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.2",
		"globals": "^16.2.0",
		"jest": "^29.7.0",
		"prettier": "^3.5.3",
		"prisma": "^6.6.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.1.1",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.20.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@prisma/client"
		]
	}
}
