  "info": {
    "title": "Swagger API",
    "description": "Swagger API文档",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ImageEntity": {
        "type": "object",
        "properties": {
          "mimetype": {
            "type": "string",
            "description": "文件类型"
          },
          "size": {
            "type": "number",
            "description": "文件大小 byt"
          },
          "filename": {
            "type": "string",
            "description": "完整文件名"
          }
        },
        "required": [
          "mimetype",
          "size",
          "filename"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string",
            "description": "昵称",
            "minLength": 2,
            "maxLength": 20
          },
          "account": {
            "type": "string",
            "description": "账号",
            "minLength": 5,
            "maxLength": 20
          },
          "password": {
            "type": "string",
            "description": "密码",
            "minLength": 8,
            "maxLength": 30
          },
          "confirm_password": {
            "type": "string",
            "description": "二次验证密码"
          }
        },
        "required": [
          "nickname",
          "account",
          "password",
          "confirm_password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "description": "账号",
            "minLength": 5,
            "maxLength": 20
          },
          "password": {
            "type": "string",
            "description": "密码",
            "minLength": 8,
            "maxLength": 30
          }
        },
        "required": [
          "account",
          "password"
        ]
      },
      "LoginEntity": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "token"
          },
          "expiration": {
            "type": "number",
            "description": "过期时间 ms"
          }
        },
        "required": [
          "access_token",
          "expiration"
        ]
      }
    }
  }
