{
	"$schema": "https://json.schemastore.org/nest-cli",
	"collection": "@nestjs/schematics",
	"sourceRoot": "src",
	"compilerOptions": {
		"deleteOutDir": true,
		"watchAssets": true,
		"assets": [
			{
				"include": "../prisma/generated",
				"outDir": "dist/prisma",
				"watchAssets": true
			}
		],
		"plugins": [
			{
				"name": "@nestjs/swagger",
				"options": {
					"classValidatorShim": true,
					"introspectComments": true
				}
			}
		]
	}
}
